rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn()
        && resource.data.uid is string
        && resource.data.uid == request.auth.uid;
    }

    function isCreatingOwnDocument() {
      return isSignedIn()
        && request.resource.data.uid is string
        && request.resource.data.uid == request.auth.uid;
    }

    function keepsOwnerUid() {
      return request.resource.data.uid == resource.data.uid;
    }

    function keepsCreatedAt() {
      return request.resource.data.createdAt == resource.data.createdAt;
    }

    function hasAllowedFields() {
      return request.resource.data.keys().hasOnly([
        "uid",
        "destination",
        "title",
        "summary",
        "days",
        "startLocation",
        "startTime",
        "endLocation",
        "endTime",
        "favorite",
        "createdAt"
      ]);
    }

    function hasRequiredFields() {
      return request.resource.data.keys().hasAll([
        "uid",
        "title",
        "summary",
        "days",
        "favorite",
        "createdAt"
      ]);
    }

    function hasValidTopLevelTypes() {
      return request.resource.data.uid is string
        && request.resource.data.title is string
        && request.resource.data.summary is string
        && request.resource.data.days is list
        && request.resource.data.favorite is bool;
    }

    function hasValidTravelConditions() {
      return (!request.resource.data.keys().hasAny(["startLocation"])
          || (request.resource.data.startLocation is string
            && request.resource.data.startLocation.size() >= 1
            && request.resource.data.startLocation.size() <= 200))
        && (!request.resource.data.keys().hasAny(["endLocation"])
          || (request.resource.data.endLocation is string
            && request.resource.data.endLocation.size() >= 1
            && request.resource.data.endLocation.size() <= 200))
        && (!request.resource.data.keys().hasAny(["startTime"])
          || (request.resource.data.startTime is string
            && request.resource.data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!request.resource.data.keys().hasAny(["endTime"])
          || (request.resource.data.endTime is string
            && request.resource.data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')));
    }

    function hasValidCreateValues() {
      return request.resource.data.uid.size() > 0
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.summary.size() >= 1
        && request.resource.data.summary.size() <= 2000
        && request.resource.data.days.size() >= 1
        && request.resource.data.days.size() <= 14
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdAt == request.time;
    }

    function onlyUpdatesEditableFields() {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "title",
          "summary",
          "startLocation",
          "startTime",
          "endLocation",
          "endTime",
          "favorite"
        ]);
    }

    function hasValidUpdatedFields() {
      let affectedKeys = request.resource.data
        .diff(resource.data)
        .affectedKeys();

      return (!affectedKeys.hasAny(["title"])
          || (request.resource.data.title is string
            && request.resource.data.title.size() >= 1
            && request.resource.data.title.size() <= 120))
        && (!affectedKeys.hasAny(["summary"])
          || (request.resource.data.summary is string
            && request.resource.data.summary.size() >= 1
            && request.resource.data.summary.size() <= 2000))
        && (!affectedKeys.hasAny(["favorite"])
          || request.resource.data.favorite is bool);
    }

    match /travelPlans/{planId} {
      allow create: if isCreatingOwnDocument()
        && hasAllowedFields()
        && hasRequiredFields()
        && hasValidTopLevelTypes()
        && hasValidTravelConditions()
        && hasValidCreateValues();

      allow get, list: if isOwner();

      allow update: if isOwner()
        && keepsOwnerUid()
        && keepsCreatedAt()
        && hasAllowedFields()
        && hasRequiredFields()
        && hasValidTopLevelTypes()
        && hasValidTravelConditions()
        && onlyUpdatesEditableFields()
        && hasValidUpdatedFields();

      allow delete: if isOwner();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
